msgstr "Azonnali keresés konkrét címekre"

msgid "Personal Features"
msgstr ""

msgid "Reading Progress"
msgstr "Olvasási előrehaladás"

msgid "Track which issues you've completed"
msgstr "Kövesse nyomon, mely feladatokat fejezett be"

msgid "Continue Reading"
msgstr "Olvasás folytatása"

